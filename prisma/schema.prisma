generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
}

enum OrderStatus {
  PENDING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETE
  FAILED
  CANCELED
}

// How a product is fulfilled: from stock, or made/sourced per order (no
// stock held — purchase happens via a quote request instead of the cart).
enum ProductFulfilment {
  STOCK
  MADE_TO_ORDER
}

enum QuoteStatus {
  PENDING
  QUOTED
  ACCEPTED
  DECLINED
}

// id mirrors the Supabase Auth user id (auth.users.id)
model User {
  id        String          @id @default(uuid())
  email     String          @unique
  // Only set in local auth mode (AUTH_MODE=local); Supabase owns passwords otherwise
  passwordHash String?
  firstName String?
  lastName  String?
  phone     String?
  avatarUrl String?
  // Customer's default address (pre-fills checkout)
  address    String?
  city       String?
  postalCode String?
  country    String?
  role      Role            @default(CUSTOMER)
  // Per-module admin permissions: { [module]: { view, create, edit, delete } }
  permissions Json?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  orders    Order[]
  tickets   Ticket[]        @relation("TicketOwner")
  assignedTickets Ticket[]  @relation("TicketAssignee")
  messages  TicketMessage[]
  payments  Payment[]
  reviews   Review[]
  quotes    QuoteRequest[]
  // ---- MLM / affiliation layer (points, 3 levels) ----
  // Unique referral code to share (e.g. ESN-7K2M9Q)
  referralCode  String?  @unique
  // Direct referrer (level 1 upline). Builds the referral tree.
  referredBy    User?    @relation("Referral", fields: [referredById], references: [id])
  referredById  String?
  referrals     User[]   @relation("Referral")
  // Cumulative points balance (denormalized; history is in the ledger)
  pointsBalance Int      @default(0)
  pointsEarned    ReferralCommission[] @relation("Beneficiary")
  pointsGenerated ReferralCommission[] @relation("Source")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// Configurable MLM schedule (single row). Editable by admin/moderator.
model MlmConfig {
  id                 String   @id @default("default")
  // Points-earning rate per level (fraction of the order value)
  level1Rate         Float    @default(0.10)
  level2Rate         Float    @default(0.05)
  level3Rate         Float    @default(0.02)
  // Value of a point when spending, in FCFA (0.1 => 100 pts = 10 FCFA)
  pointValueFcfa     Float    @default(0.10)
  // Maximum number of direct referrals per member (0 = unlimited)
  maxDirectReferrals Int      @default(3)
  updatedAt          DateTime @updatedAt
}

// MLM points ledger: one row per tier credited on a purchase.
model ReferralCommission {
  id            String   @id @default(uuid())
  // Beneficiary (upline member) credited the points
  beneficiary   User     @relation("Beneficiary", fields: [beneficiaryId], references: [id])
  beneficiaryId String
  // Referral whose purchase generated the points
  source        User     @relation("Source", fields: [sourceId], references: [id])
  sourceId      String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  level         Int      // 1 (direct), 2 or 3
  points        Int
  createdAt     DateTime @default(now())

  // Idempotence: a beneficiary can only be credited once per order
  @@unique([orderId, beneficiaryId])
  @@index([beneficiaryId])
}

model Review {
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  // color tag shown on the storefront/admin (Red|Blue|Green|Purple|Orange|Pink)
  color       String    @default("Red")
  // Icon key (from the frontend's icon registry) shown ONLY on the homepage
  // "Shop by Category" section, and only when `featured` is true.
  icon        String?
  // Whether this category appears in the homepage "Shop by Category" section.
  featured    Boolean   @default(false)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id           String      @id @default(uuid())
  name         String
  description  String?
  price        Decimal     @db.Decimal(10, 2)
  // optional "was" price shown struck-through
  comparePrice Decimal?    @db.Decimal(10, 2)
  sku          String?
  stock        Int         @default(0)
  // Reorder threshold / max shelf capacity — inventory management, admin-only.
  stockMin     Int?
  stockMax     Int?
  imageUrl     String?
  // false = saved as draft (hidden from storefront)
  isActive     Boolean     @default(true)
  // STOCK: sold from `stock` via the normal cart/checkout.
  // MADE_TO_ORDER: no stock held — the storefront shows a "Request a quote"
  // CTA instead of "Add to cart" (the customer is never told it's MTO).
  fulfilment   ProductFulfilment @default(STOCK)
  category     Category?   @relation(fields: [categoryId], references: [id])
  categoryId   String?
  orderItems   OrderItem[]
  reviews      Review[]
  quotes       QuoteRequest[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// A customer's request for a quote on a made-to-order product. Replaces the
// normal cart/checkout flow for MADE_TO_ORDER products.
model QuoteRequest {
  id            String      @id @default(uuid())
  product       Product     @relation(fields: [productId], references: [id])
  productId     String
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  quantity      Int         @default(1)
  message       String?
  status        QuoteStatus @default(PENDING)
  // Set by staff once priced.
  quotedPrice   Decimal?    @db.Decimal(10, 2)
  quotedMessage String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model Order {
  id        String      @id @default(uuid())
  // Optional: guest checkout has no account. See `guestEmail` below.
  user      User?       @relation(fields: [userId], references: [id])
  userId    String?
  // Email captured at checkout for a guest order (no matching/created account).
  // Cleared once the order is linked to an account (on match or on sign-up).
  guestEmail String?
  status    OrderStatus @default(PENDING)
  total     Decimal     @db.Decimal(10, 2)
  // captured at checkout: { fullName, email, phone, address, city, postalCode, country }
  shippingAddress Json?
  shippingMethod  String?
  shippingCost    Decimal? @db.Decimal(10, 2)
  // MLM points used to pay for part of this order (100 pts = 10 FCFA)
  pointsUsed      Int      @default(0)
  // set by admin when fulfilling
  trackingNumber  String?
  carrier         String?
  notes           String?
  items     OrderItem[]
  payments  Payment[]
  tickets   Ticket[]
  referralCommissions ReferralCommission[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([guestEmail])
}

model OrderItem {
  id        String  @id @default(uuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
}

model Payment {
  id        String        @id @default(uuid())
  order     Order         @relation(fields: [orderId], references: [id])
  orderId   String
  // Optional: mirrors Order.userId — null for a guest order paid without an account.
  user      User?         @relation(fields: [userId], references: [id])
  userId    String?
  reference String        @unique // Notch Pay transaction reference
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(10, 2)
  currency  String        @default("XAF")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Ticket {
  id         String          @id @default(uuid())
  // human-friendly reference shown as TKT-001
  number     Int             @unique @default(autoincrement())
  user       User            @relation("TicketOwner", fields: [userId], references: [id])
  userId     String
  subject    String
  status     TicketStatus    @default(OPEN)
  priority   TicketPriority  @default(NORMAL)
  // e.g. Delivery, Order Issue, Payment, Return, General
  category   String?
  // optional link to the order the ticket is about
  order      Order?          @relation(fields: [orderId], references: [id])
  orderId    String?
  // staff member handling the ticket
  assignee   User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  assigneeId String?
  messages   TicketMessage[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  content   String   @default("")
  // Optional image attachment (e.g. a screenshot) hosted in the storage bucket
  imageUrl  String?
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  name      String
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

// Daily uptime aggregate per service (for the commits-style heatmap).
model ServiceDay {
  service String
  day     String // YYYY-MM-DD (UTC)
  up      Int    @default(0)
  total   Int    @default(0)

  @@id([service, day])
}

// Downtime incident history per service.
model ServiceIncident {
  id         String    @id @default(uuid())
  service    String
  error      String?
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([service, startedAt])
}

// Single configurable row: the promo message shown in the header's
// announcement bar, centered on the Affiliate Program line. `code` is kept
// separate from `message` so the admin UI can show/copy it distinctly, but
// the storefront just renders `message` as-is (author includes the code in
// the wording if they want it visible, e.g. "10% off with code WELCOME10").
model PromoBanner {
  id        String   @id @default("default")
  message   String   @default("")
  code      String?
  active    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// A customer/partner testimonial shown on the homepage.
model Testimonial {
  id          String   @id @default(uuid())
  authorName  String
  authorTitle String?
  avatarUrl   String?
  // 1-5, optional (a quote-only testimonial can omit a star rating)
  rating      Int?
  quote       String
  isActive    Boolean  @default(true)
  // Lower sorts first; ties broken by createdAt.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}
